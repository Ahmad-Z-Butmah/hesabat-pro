    {
      "parameters": {
        "jsCode": "const checks = $json.checks || [];\nconst lines = checks.map(c => `#${c.id} | ${c.bank || ''} | رقم ${c.check_number || ''} | ${Number(c.amount || 0).toLocaleString('ar')} ${c.currency || 'ILS'} | حامل: ${c.current_holder || ''} | حالة: ${c.status || ''}`);\nreturn [{\n  json: {\n    check_ids: checks.map(c => c.id),\n    subject: `Infinity - تذكير شيكات مستحقة غدًا (${checks.length})`,\n    html: `<h2>شيكات مستحقة غدًا</h2><p>عدد الشيكات: ${checks.length}</p><pre>${lines.join('\\n')}</pre>`,\n    text: `شيكات مستحقة غدًا\\n\\n${lines.join('\\n')}`\n  }\n}];"
      },
