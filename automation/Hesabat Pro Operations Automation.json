    {
      "parameters": {
        "jsCode": "const tabs = $json.tabs || {};\nconst output = [];\nfor (const [moduleSlug, payload] of Object.entries(tabs)) {\n  const fields = payload.fields || [];\n  const rows = payload.rows || [];\n  for (const row of rows) {\n    const flat = { module: moduleSlug, id: row.id };\n    for (const field of fields) {\n      flat[field.label || field.key] = row[field.key] ?? '';\n    }\n    flat.created_at = row.created_at || '';\n    flat.updated_at = row.updated_at || '';\n    output.push({ json: flat });\n  }\n}\nreturn output.length ? output : [{ json: { module: 'empty', message: 'No rows to sync' } }];"
      },
